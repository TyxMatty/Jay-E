{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Jay-E",
  "version": "0.2.2",
  "identifier": "io.github.tyxmatty.jaye",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5177",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jay-E",
        "width": 1100,
        "height": 720,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost jaye: http://jaye.localhost",
        "media-src": "'self' data: blob: asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost jaye: http://jaye.localhost",
        "font-src": "'self' data:"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "TyxMatty",
    "copyright": "© 2026 TyxMatty. MIT License.",
    "fileAssociations": [
      { "ext": ["pdf"], "name": "Jay-E.PDF", "description": "PDF document", "role": "Editor" },
      { "ext": ["docx", "odt", "rtf"], "name": "Jay-E.Document", "description": "Document", "role": "Editor" },
      { "ext": ["md", "markdown"], "name": "Jay-E.Markdown", "description": "Markdown document", "role": "Editor" },
      { "ext": ["tex"], "name": "Jay-E.LaTeX", "description": "LaTeX document", "role": "Editor" },
      { "ext": ["txt"], "name": "Jay-E.Text", "description": "Text file", "role": "Editor" },
      { "ext": ["png", "jpg", "jpeg", "webp", "gif", "bmp", "tif", "tiff", "ico", "qoi"], "name": "Jay-E.Image", "description": "Image", "role": "Editor" },
      { "ext": ["mp4", "mov", "webm"], "name": "Jay-E.Video", "description": "Video", "role": "Editor" },
      { "ext": ["m4a", "mp3", "wav"], "name": "Jay-E.Audio", "description": "Audio", "role": "Viewer" }
    ],
    "category": "Productivity",
    "shortDescription": "Documents, images and video: read, edit and convert",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "PortugueseBR"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
